# ===================== Supabase =====================
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: HANYA dipakai di server (API routes). Jangan expose ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# ===================== WhatsApp Cloud API =====================
# Token bebas buatan Anda; harus sama dengan "Verify token" di Meta App > WhatsApp > Configuration
WEBHOOK_VERIFY_TOKEN=ganti-dengan-token-rahasia
# Meta App > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
# Disarankan System User access token permanen (permission: whatsapp_business_messaging)
WA_ACCESS_TOKEN=

# ===================== Meta Conversions API =====================
# Dataset ID (Events Manager > Data sources > dataset yang terhubung ke WhatsApp)
META_DATASET_ID=
# Access token Conversions API untuk dataset tersebut
META_ACCESS_TOKEN=
# Opsional: kode dari tab "Test events" di Events Manager. Kosongkan di production.
META_TEST_EVENT_CODE=

# ===================== Opsional =====================
# WhatsApp Business Account ID; bila diisi dikirim sebagai user_data.whatsapp_business_account_id
WA_BUSINESS_ACCOUNT_ID=
# App Secret Meta App; bila diisi, webhook memverifikasi header X-Hub-Signature-256
META_APP_SECRET=

# ===================== Mode =====================
# true  = balasan CS hanya disimpan ke database (tidak memanggil WhatsApp API)
# false = balasan CS dikirim ke WhatsApp Cloud API
MOCK_MODE=true

# ===================== AI Chatbot (Gemini) =====================
# API key Google AI Studio. Kosongkan untuk memakai chatbot rule-based (fallback).
GEMINI_API_KEY=
# Opsional, default gemini-2.5-flash
GEMINI_MODEL=
# Opsional, nama CS di kalimat pembuka bot (default: Galuh)
BOT_CS_NAME=

# ===================== Cron CAPI Sync =====================
# Bila diisi, /api/cron/capi-sync hanya menerima header "Authorization: Bearer <CRON_SECRET>"
# (Vercel Cron mengirim header ini otomatis).
CRON_SECRET=

# ===================== Login (Admin / Agent) =====================
# Secret untuk menandatangani cookie sesi. WAJIB, minimal 32 karakter acak.
# Buat dengan: openssl rand -base64 48
AUTH_SECRET=
# Akun Admin pertama: dibuat otomatis saat login pertama kali selama tabel
# app_users masih kosong. Setelah itu kelola user dari tab "Pengguna".
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ===================== Privacy Policy (/privacy) =====================
# Kontak untuk permintaan akses/penghapusan data, tampil di halaman /privacy
# (URL ini dipakai sebagai Privacy Policy URL saat publish Meta App).
PRIVACY_CONTACT=
